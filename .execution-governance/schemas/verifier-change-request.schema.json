{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manu-ai.local/execution-governance/verifier-change-request.schema.json",
  "title": "Execution Governance Verifier Change Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "requestId",
    "reason",
    "affectedRequirementIds",
    "requestedAcceptanceChanges",
    "protectionImpact",
    "negativeControls",
    "requiredReview",
    "planVersionChange",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "affectedRequirementIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requestedAcceptanceChanges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protectionImpact": {
      "type": "string",
      "minLength": 1
    },
    "negativeControls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredReview": {
      "type": "string",
      "enum": [
        "FULL_PLAN_COMPLIANCE",
        "TARGETED_CORRECTED_ITEMS",
        "USER_DECISION_REQUIRED"
      ]
    },
    "planVersionChange": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "REQUESTED",
        "APPROVED_BY_USER",
        "REJECTED_BY_USER",
        "SUPERSEDED"
      ]
    }
  }
}
