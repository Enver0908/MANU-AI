{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manu-ai.local/execution-governance/run-record.schema.json",
  "title": "Execution Governance Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "runId",
    "timestamp",
    "commitSha",
    "actor",
    "command",
    "exitCode",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cwd",
        "executable",
        "args"
      ],
      "properties": {
        "cwd": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "$ref": "status-model.schema.json#/definitions/executor_checks"
    }
  }
}
