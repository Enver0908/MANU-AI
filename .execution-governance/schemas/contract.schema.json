{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manu-ai.local/execution-governance/contract.schema.json",
  "title": "Execution Governance Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "planVersion",
    "planTitle",
    "authoritySources",
    "roleBindings",
    "status",
    "requirements"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "planVersion": {
      "type": "string",
      "minLength": 1
    },
    "planTitle": {
      "type": "string",
      "minLength": 1
    },
    "authoritySources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roleBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementAuthority",
        "planner",
        "implementer",
        "automaticVerifier",
        "independentReviewer",
        "manualReviewer",
        "finalAcceptanceAuthority"
      ],
      "properties": {
        "requirementAuthority": {
          "type": "string",
          "minLength": 1
        },
        "planner": {
          "type": "string",
          "minLength": 1
        },
        "implementer": {
          "type": "string",
          "minLength": 1
        },
        "automaticVerifier": {
          "type": "string",
          "minLength": 1
        },
        "independentReviewer": {
          "type": "string",
          "minLength": 1
        },
        "manualReviewer": {
          "type": "string",
          "minLength": 1
        },
        "finalAcceptanceAuthority": {
          "type": "string",
          "const": "user"
        }
      }
    },
    "status": {
      "$ref": "status-model.schema.json"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementId",
          "authoritySource",
          "classification",
          "observableRequirement",
          "dependencies",
          "status"
        ],
        "properties": {
          "requirementId": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
          },
          "authoritySource": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "IN_SCOPE",
              "OUT_OF_SCOPE_WITH_REASON",
              "BLOCKED_BY_DECISION",
              "SUPERSEDED_BY_APPROVED_AUTHORITY"
            ]
          },
          "observableRequirement": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "$ref": "status-model.schema.json"
          }
        }
      }
    }
  }
}
