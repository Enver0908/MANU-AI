{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manu-ai.local/execution-governance/lifecycle-record.schema.json",
  "title": "Execution Governance Lifecycle Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "planDirectory",
    "currentPhase",
    "status",
    "events",
    "independentReviewPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "planDirectory": {
      "type": "string",
      "minLength": 1
    },
    "currentPhase": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "status-model.schema.json"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "timestamp",
          "actor",
          "eventType",
          "summary"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "eventType": {
            "type": "string",
            "enum": [
              "PLAN_DRAFTED",
              "PLAN_APPROVED",
              "PLAN_LOCKED",
              "IMPLEMENTATION_STARTED",
              "IMPLEMENTATION_REPORTED",
              "EXECUTOR_CHECK_RECORDED",
              "SCOPE_CHANGE_REQUESTED",
              "SCOPE_CHANGE_APPROVED",
              "VERIFIER_CHANGE_REQUESTED",
              "VERIFIER_CHANGE_APPROVED",
              "REVIEW_REQUESTED",
              "REVIEW_RECORDED",
              "WAIVER_RECORDED",
              "USER_ACCEPTED",
              "USER_REJECTED",
              "COMMIT_RECORDED",
              "BLOCKED"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "recordPath": {
            "type": "string"
          }
        }
      }
    },
    "independentReviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultState",
        "requiresExplicitUserRequest",
        "createReviewRecordWhenNotRequested",
        "reviewerMayModifyImplementation"
      ],
      "properties": {
        "defaultState": {
          "type": "string",
          "const": "NOT_REQUESTED"
        },
        "requiresExplicitUserRequest": {
          "type": "boolean",
          "const": true
        },
        "createReviewRecordWhenNotRequested": {
          "type": "boolean",
          "const": false
        },
        "reviewerMayModifyImplementation": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
