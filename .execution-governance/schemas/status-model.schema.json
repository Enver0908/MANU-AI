{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manu-ai.local/execution-governance/status-model.schema.json",
  "title": "Execution Governance Status Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_state",
    "implementation_state",
    "executor_checks",
    "independent_review",
    "user_acceptance"
  ],
  "properties": {
    "plan_state": {
      "$ref": "#/definitions/plan_state"
    },
    "implementation_state": {
      "$ref": "#/definitions/implementation_state"
    },
    "executor_checks": {
      "$ref": "#/definitions/executor_checks"
    },
    "independent_review": {
      "$ref": "#/definitions/independent_review"
    },
    "user_acceptance": {
      "$ref": "#/definitions/user_acceptance"
    }
  },
  "definitions": {
    "plan_state": {
      "type": "string",
      "enum": [
        "PLAN_DRAFT",
        "PLAN_BLOCKED",
        "VERIFIER_SETUP_REQUIRED",
        "READY_FOR_IMPLEMENTATION",
        "LOCKED_FOR_IMPLEMENTATION"
      ]
    },
    "implementation_state": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "IMPLEMENTED_UNVERIFIED",
        "BLOCKED",
        "FAIL",
        "EXECUTOR_VERIFIED"
      ]
    },
    "executor_checks": {
      "type": "string",
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "BLOCKED",
        "SKIPPED_WITH_REASON"
      ]
    },
    "independent_review": {
      "type": "string",
      "enum": [
        "NOT_REQUESTED",
        "REQUESTED",
        "IN_PROGRESS",
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "user_acceptance": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACCEPTED",
        "REJECTED",
        "WAIVED_BY_USER"
      ]
    }
  }
}
