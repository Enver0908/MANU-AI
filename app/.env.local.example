# Commercial admin operations require this Supabase project to be reachable and migrated.
# MANU_DEV_FALLBACK_STORE=true keeps the demo usable, but it is not a commercial admin data store.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
MANU_DEV_FALLBACK_STORE=true
MANU_ALLOW_PUBLIC_DEMO_LOGIN=true
MANU_DEMO_PASSWORD=manu-local-demo-password
MANU_ALLOW_STRIPE_SANDBOX=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Supabase Auth redirect URLs must include:
# http://127.0.0.1:3000/auth/callback
# https://siriusai.store/auth/callback
# https://admin.siriusai.store/auth/callback
MANU_ADMIN_EMAIL_ALLOWLIST=olkuenver@gmail.com
MANU_ADMIN_HOST=admin.siriusai.store
# Local can omit this and reuse NEXT_PUBLIC_APP_URL; VPS should set https://admin.siriusai.store.
MANU_ADMIN_APP_URL=
MANU_COMMERCIAL_INVITE_PEPPER=replace-with-32-char-minimum-pepper
MANU_ALLOW_COMMERCIAL_ADMIN=false
MANU_COMMERCIAL_ADMIN_TOKEN=replace-with-32-char-minimum-admin-token
